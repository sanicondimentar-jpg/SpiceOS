{
  "realm": "spiceos",
  "enabled": true,
  "organizationsEnabled": true,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "otpPolicyType": "totp",
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true }
  ],
  "clients": [
    {
      "clientId": "spiceos-web",
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "change-me",
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["openid", "profile", "email", "organization"],
      "protocolMappers": [
        {
          "name": "audience-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.client.audience": "spiceos-api", "access.token.claim": "true" }
        }
      ]
    },
    { "clientId": "spiceos-api", "bearerOnly": true, "protocol": "openid-connect" }
  ]
}
