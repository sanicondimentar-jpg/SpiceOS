# --- Base de datos ---
POSTGRES_USER=spiceos
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spiceos
# usuario de la app SIN bypass de RLS (se crea en la migración 0001_rls)
DATABASE_URL=postgresql://spiceos_app:change-me-app@localhost:5432/spiceos
# usuario dueño, solo para migraciones
MIGRATION_DATABASE_URL=postgresql://spiceos:change-me@localhost:5432/spiceos
# procesos de sistema (outbox relay, scheduler) con BYPASSRLS
SYSTEM_DATABASE_URL=postgresql://spiceos_system:change-me-system@localhost:5432/spiceos

