{
  "name": "spiceos",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @spiceos/api prisma:migrate",
    "db:seed": "pnpm --filter @spiceos/api prisma:seed",
    "infra:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d",
    "infra:down": "docker compose -f infra/compose/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "protobufjs"
    ]
  }
}
