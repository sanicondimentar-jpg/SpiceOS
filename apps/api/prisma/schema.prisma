// =============================================================================
// SpiceOS — esquema de datos
// Convenciones:
//  - Toda tabla de negocio lleva tenant_id (empresa). El aislamiento lo garantiza
//    Row Level Security en PostgreSQL (ver migrations/0001_rls). tenant_id no se
//    declara como relación a Company para no acoplar cada módulo al núcleo.
//  - Ids UUID v4, timestamps con zona horaria, borrado lógico con deleted_at.
//  - Montos: Decimal(18,4). Cantidades: Decimal(18,3) (kg, unidades).
//  - version = bloqueo optimista en agregados.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, citext]
}

// -----------------------------------------------------------------------------
// CORE: empresas, sucursales, usuarios, roles, permisos, configuración
// -----------------------------------------------------------------------------

model Company {
  id              String       @id @default(uuid()) @db.Uuid
  keycloakOrgId   String       @unique @map("keycloak_org_id")
  legalName       String       @map("legal_name")
  tradeName       String?      @map("trade_name")
  taxId           String       @map("tax_id") // CUIT
  country         String       @default("AR") @db.Char(2)
  baseCurrency    String       @default("ARS") @map("base_currency") @db.Char(3)
  timezone        String       @default("America/Argentina/Buenos_Aires")
  plan            String       @default("standard")
  status          TenantStatus @default(ACTIVE)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  branches    Branch[]
  memberships Membership[]
  roles       Role[]

  @@map("companies")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Branch {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  code      String
  name      String
  address   Json?
  isMain    Boolean   @default(false) @map("is_main")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  company    Company     @relation(fields: [tenantId], references: [id])
  warehouses Warehouse[]

  @@unique([tenantId, code])
  @@map("branches")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  keycloakId   String    @unique @map("keycloak_id")
  email        String    @unique @db.Citext
  fullName     String    @map("full_name")
  phone        String?
  avatarUrl    String?   @map("avatar_url")
  locale       String    @default("es-AR")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  memberships Membership[]

  @@map("users")
}

// Un usuario pertenece a N empresas; en cada una tiene un rol y un alcance de sucursales.
model Membership {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  branchScope String[] @default([]) @map("branch_scope") @db.Uuid // vacío = todas
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  company Company @relation(fields: [tenantId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([tenantId, userId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  key         String // admin, gerente, vendedor, deposito, cobranzas...
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  maxDiscount Decimal  @default(0) @map("max_discount") @db.Decimal(5, 2) // tope de descuento sin aprobación
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  company     Company          @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  memberships Membership[]

  @@unique([tenantId, key])
  @@map("roles")
}

// Catálogo global de permisos: "<modulo>.<recurso>.<accion>", ej. "sales.quote.approve"
model Permission {
  key         String           @id
  module      String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId        String     @map("role_id") @db.Uuid
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key])

  @@id([roleId, permissionKey])
  @@map("role_permissions")
}

model Setting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy String?  @map("updated_by") @db.Uuid

  @@id([tenantId, key])
  @@map("settings")
}

model ExchangeRate {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  currency  String   @db.Char(3)
  rate      Decimal  @db.Decimal(18, 6) // 1 unidad de currency = rate en moneda base
  date      DateTime @db.Date
  source    String   @default("manual")

  @@unique([tenantId, currency, date])
  @@map("exchange_rates")
}

model TaxRate {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String // IVA21, IVA10.5, PERC_IIBB_BA
  name     String
  rate     Decimal @db.Decimal(7, 4)
  kind     String  @default("VAT") // VAT, PERCEPTION, WITHHOLDING
  isActive Boolean @default(true) @map("is_active")

  @@unique([tenantId, code])
  @@map("tax_rates")
}

// Numeradores de comprobantes por sucursal (pedidos, cotizaciones, OC).
model Sequence {
  tenantId String @map("tenant_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid
  key      String
  prefix   String @default("")
  next     Int    @default(1)

  @@id([tenantId, branchId, key])
  @@map("sequences")
}

// -----------------------------------------------------------------------------
// AUDITORÍA Y EVENTOS
// -----------------------------------------------------------------------------

model AuditLog {
  id            BigInt    @id @default(autoincrement())
  tenantId      String    @map("tenant_id") @db.Uuid
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  actorType     ActorType @map("actor_type")
  actorId       String    @map("actor_id") // user uuid, "agent:commercial", "rule:<id>"
  onBehalfOf    String?   @map("on_behalf_of") @db.Uuid // usuario que pidió la acción a un agente
  action        String // customer.update, quote.approve
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?   @map("user_agent")
  correlationId String?   @map("correlation_id")

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt])
  @@map("audit_logs")
}

enum ActorType {
  USER
  AGENT
  RULE
  SYSTEM
  INTEGRATION
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  type          String // order.confirmed
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz
  publishedAt   DateTime? @map("published_at") @db.Timestamptz
  attempts      Int       @default(0)
  correlationId String?   @map("correlation_id")

  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}

// Archivos binarios propios (MinIO/S3). Cualquier entidad puede adjuntar.
model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  storageKey  String   @map("storage_key")
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  checksum    String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?  @map("created_by") @db.Uuid

  @@index([tenantId, entityType, entityId])
  @@map("attachments")
}

// -----------------------------------------------------------------------------
// CRM
// -----------------------------------------------------------------------------

model Customer {
  id               String         @id @default(uuid()) @db.Uuid
  tenantId         String         @map("tenant_id") @db.Uuid
  branchId         String?        @map("branch_id") @db.Uuid
  code             String
  legalName        String         @map("legal_name")
  tradeName        String?        @map("trade_name")
  taxId            String?        @map("tax_id")
  taxCondition     String?        @map("tax_condition") // RI, Monotributo, CF, Exento
  type             CustomerType   @default(BUSINESS)
  industry         String? // restaurante, frigorífico, panadería, distribuidor...
  status           CustomerStatus @default(ACTIVE)
  ownerId          String?        @map("owner_id") @db.Uuid // vendedor asignado
  priceListId      String?        @map("price_list_id") @db.Uuid
  paymentTermsDays Int            @default(0) @map("payment_terms_days")
  creditLimit      Decimal?       @map("credit_limit") @db.Decimal(18, 4)
  phone            String? // E.164; clave para asociar WhatsApp
  email            String?        @db.Citext
  website          String?
  source           String? // whatsapp, web, feria, referido
  tags             String[]       @default([])
  customFields     Json           @default("{}") @map("custom_fields")
  lastOrderAt      DateTime?      @map("last_order_at") @db.Timestamptz // denormalizado por evento
  riskScore        Int?           @map("risk_score") // 0-100
  aiSummary        String?        @map("ai_summary")
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz
  createdBy        String?        @map("created_by") @db.Uuid
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  updatedBy        String?        @map("updated_by") @db.Uuid
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz

  contacts      Contact[]
  addresses     CustomerAddress[]
  notes         CustomerNote[]
  segments      CustomerSegment[]
  opportunities Opportunity[]
  quotes        Quote[]
  orders        SalesOrder[]
  account       CustomerAccount?
  conversations Conversation[]
  priceList     PriceList?        @relation(fields: [priceListId], references: [id])

  @@unique([tenantId, code])
  @@unique([tenantId, taxId])
  @@index([tenantId, phone])
  @@index([tenantId, lastOrderAt])
  @@map("customers")
}

enum CustomerType {
  BUSINESS
  INDIVIDUAL
}

enum CustomerStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

model Contact {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  fullName   String    @map("full_name")
  position   String?
  phone      String?
  email      String?   @db.Citext
  isPrimary  Boolean   @default(false) @map("is_primary")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, phone])
  @@map("contacts")
}

model CustomerAddress {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  label        String   @default("Principal")
  street       String
  city         String
  province     String
  postalCode   String?  @map("postal_code")
  lat          Float?
  lng          Float?
  deliveryNote String?  @map("delivery_note")
  isDefault    Boolean  @default(false) @map("is_default")

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_addresses")
}

model CustomerNote {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy  String?  @map("created_by") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id])

  @@map("customer_notes")
}

model Segment {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  name        String
  description String?
  isDynamic   Boolean           @default(false) @map("is_dynamic")
  rule        Json? // filtro declarativo para segmentos dinámicos
  members     CustomerSegment[]

  @@unique([tenantId, name])
  @@map("segments")
}

model CustomerSegment {
  customerId String   @map("customer_id") @db.Uuid
  segmentId  String   @map("segment_id") @db.Uuid
  addedAt    DateTime @default(now()) @map("added_at") @db.Timestamptz

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  segment  Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@id([customerId, segmentId])
  @@map("customer_segments")
}

// Línea de tiempo unificada del Customer 360: llamadas, visitas, mensajes, emails.
model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  type        ActivityType
  subject     String
  body        String?
  entityType  String       @map("entity_type") // customer, lead, opportunity
  entityId    String       @map("entity_id") @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  userId      String?      @map("user_id") @db.Uuid
  metadata    Json         @default("{}")

  @@index([tenantId, entityType, entityId, occurredAt])
  @@map("activities")
}

enum ActivityType {
  CALL
  VISIT
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  SAMPLE_SENT
  COMPLAINT
}

// -----------------------------------------------------------------------------
// VENTAS
// -----------------------------------------------------------------------------

model Lead {
  id           String     @id @default(uuid()) @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  name         String
  company      String?
  phone        String?
  email        String?    @db.Citext
  source       String // whatsapp, web, feria
  status       LeadStatus @default(NEW)
  ownerId      String?    @map("owner_id") @db.Uuid
  score        Int? // 0-100, calculado por IA
  notes        String?
  convertedCustomerId String? @map("converted_customer_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId, status])
  @@index([tenantId, phone])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISCARDED
}

model Pipeline {
  id       String          @id @default(uuid()) @db.Uuid
  tenantId String          @map("tenant_id") @db.Uuid
  name     String
  stages   PipelineStage[]

  @@map("pipelines")
}

model PipelineStage {
  id          String  @id @default(uuid()) @db.Uuid
  pipelineId  String  @map("pipeline_id") @db.Uuid
  name        String
  position    Int
  probability Int // %
  isWon       Boolean @default(false) @map("is_won")
  isLost      Boolean @default(false) @map("is_lost")

  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@map("pipeline_stages")
}

model Opportunity {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  leadId        String?   @map("lead_id") @db.Uuid
  stageId       String    @map("stage_id") @db.Uuid
  title         String
  amount        Decimal?  @db.Decimal(18, 4)
  currency      String    @default("ARS") @db.Char(3)
  expectedClose DateTime? @map("expected_close") @db.Date
  ownerId       String?   @map("owner_id") @db.Uuid
  source        String? // whatsapp-intent, manual, rule
  lostReason    String?   @map("lost_reason")
  closedAt      DateTime? @map("closed_at") @db.Timestamptz
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer?     @relation(fields: [customerId], references: [id])
  stage    PipelineStage @relation(fields: [stageId], references: [id])
  quotes   Quote[]

  @@index([tenantId, stageId])
  @@index([tenantId, ownerId])
  @@map("opportunities")
}

model Quote {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  number        String
  customerId    String      @map("customer_id") @db.Uuid
  opportunityId String?     @map("opportunity_id") @db.Uuid
  status        QuoteStatus @default(DRAFT)
  currency      String      @default("ARS") @db.Char(3)
  subtotal      Decimal     @default(0) @db.Decimal(18, 4)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(18, 4)
  total         Decimal     @default(0) @db.Decimal(18, 4)
  validUntil    DateTime?   @map("valid_until") @db.Date
  notes         String?
  requiresApproval Boolean  @default(false) @map("requires_approval")
  approvedBy    String?     @map("approved_by") @db.Uuid
  pdfDocumentId String?     @map("pdf_document_id") @db.Uuid
  createdByAgent String?    @map("created_by_agent") // si la generó el copiloto
  version       Int         @default(1)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?     @map("created_by") @db.Uuid
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer    Customer     @relation(fields: [customerId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])
  lines       QuoteLine[]
  order       SalesOrder?

  @@unique([tenantId, number])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  PENDING_APPROVAL
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model QuoteLine {
  id          String  @id @default(uuid()) @db.Uuid
  quoteId     String  @map("quote_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  discountPct Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRateId   String? @map("tax_rate_id") @db.Uuid
  unitCost    Decimal @map("unit_cost") @db.Decimal(18, 4) // snapshot para margen
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 4)

  quote   Quote          @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("quote_lines")
}

model SalesTarget {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid // null = objetivo de empresa
  branchId   String?  @map("branch_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  periodEnd  DateTime @map("period_end") @db.Date
  metric     String // revenue, margin, new_customers, kg
  target     Decimal  @db.Decimal(18, 4)

  @@map("sales_targets")
}

model CommissionPlan {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  name     String
  basis    String // revenue, margin, collected
  rules    Json // tramos y porcentajes
  isActive Boolean @default(true) @map("is_active")

  commissions Commission[]

  @@map("commission_plans")
}

model Commission {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  planId      String           @map("plan_id") @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  orderId     String?          @map("order_id") @db.Uuid
  periodMonth DateTime         @map("period_month") @db.Date
  baseAmount  Decimal          @map("base_amount") @db.Decimal(18, 4)
  amount      Decimal          @db.Decimal(18, 4)
  status      CommissionStatus @default(ACCRUED)

  plan CommissionPlan @relation(fields: [planId], references: [id])

  @@map("commissions")
}

enum CommissionStatus {
  ACCRUED
  APPROVED
  PAID
}

// -----------------------------------------------------------------------------
// PRODUCTOS Y PRECIOS
// -----------------------------------------------------------------------------

model Category {
  id       String     @id @default(uuid()) @db.Uuid
  tenantId String     @map("tenant_id") @db.Uuid
  parentId String?    @map("parent_id") @db.Uuid
  name     String
  slug     String

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@map("categories")
}

model Product {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  categoryId   String?   @map("category_id") @db.Uuid
  code         String
  name         String // Pimentón ahumado
  description  String?
  origin       String? // país/región de origen
  botanicalName String?  @map("botanical_name")
  allergens    String[]  @default([])
  rnpa         String? // registro nacional de producto alimenticio
  shelfLifeDays Int?     @map("shelf_life_days")
  storageNotes String?   @map("storage_notes")
  isActive     Boolean   @default(true) @map("is_active")
  aiDescription String?  @map("ai_description")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  category       Category?              @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  certifications ProductCertification[]

  @@unique([tenantId, code])
  @@map("products")
}

// Presentación vendible: 100 g, 500 g, 1 kg, bolsa 25 kg.
model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sku          String
  gtin         String? // EAN-13
  name         String
  unit         String   @default("UN") // UN, KG
  netWeightKg  Decimal? @map("net_weight_kg") @db.Decimal(12, 3)
  currentCost  Decimal  @default(0) @map("current_cost") @db.Decimal(18, 4)
  minMarginPct Decimal  @default(0) @map("min_margin_pct") @db.Decimal(5, 2)
  minStock     Decimal  @default(0) @map("min_stock") @db.Decimal(18, 3)
  reorderPoint Decimal  @default(0) @map("reorder_point") @db.Decimal(18, 3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  product         Product             @relation(fields: [productId], references: [id])
  costHistory     CostHistory[]
  priceListItems  PriceListItem[]
  quoteLines      QuoteLine[]
  orderLines      SalesOrderLine[]
  lots            Lot[]
  stockItems      StockItem[]
  supplierProducts SupplierProduct[]
  purchaseLines   PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@map("product_variants")
}

model Certification {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String // Sin TACC, Kosher, Orgánico, BPM, HACCP
  issuer    String?
  products  ProductCertification[]

  @@unique([tenantId, name])
  @@map("certifications")
}

model ProductCertification {
  productId       String    @map("product_id") @db.Uuid
  certificationId String    @map("certification_id") @db.Uuid
  certificateNo   String?   @map("certificate_no")
  validUntil      DateTime? @map("valid_until") @db.Date
  documentId      String?   @map("document_id") @db.Uuid

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  certification Certification @relation(fields: [certificationId], references: [id])

  @@id([productId, certificationId])
  @@map("product_certifications")
}

model CostHistory {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  cost       Decimal  @db.Decimal(18, 4)
  currency   String   @default("ARS") @db.Char(3)
  source     String // purchase, manual, import
  validFrom  DateTime @default(now()) @map("valid_from") @db.Timestamptz
  createdBy  String?  @map("created_by") @db.Uuid

  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, validFrom])
  @@map("cost_history")
}

model PriceList {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String // Mayorista, Gastronomía, Minorista
  currency   String    @default("ARS") @db.Char(3)
  includesTax Boolean  @default(false) @map("includes_tax")
  validFrom  DateTime? @map("valid_from") @db.Date
  validTo    DateTime? @map("valid_to") @db.Date
  isDefault  Boolean   @default(false) @map("is_default")

  items     PriceListItem[]
  customers Customer[]

  @@unique([tenantId, name])
  @@map("price_lists")
}

model PriceListItem {
  id          String   @id @default(uuid()) @db.Uuid
  priceListId String   @map("price_list_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  price       Decimal  @db.Decimal(18, 4)
  minQuantity Decimal  @default(1) @map("min_quantity") @db.Decimal(18, 3) // escalas por volumen
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  priceList PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId, minQuantity])
  @@map("price_list_items")
}

// -----------------------------------------------------------------------------
// PEDIDOS
// -----------------------------------------------------------------------------

model SalesOrder {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  branchId      String      @map("branch_id") @db.Uuid
  warehouseId   String      @map("warehouse_id") @db.Uuid
  number        String
  customerId    String      @map("customer_id") @db.Uuid
  quoteId       String?     @unique @map("quote_id") @db.Uuid
  status        OrderStatus @default(DRAFT)
  channel       String      @default("sales_rep") // sales_rep, whatsapp, portal, copilot
  currency      String      @default("ARS") @db.Char(3)
  subtotal      Decimal     @default(0) @db.Decimal(18, 4)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(18, 4)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(18, 4)
  total         Decimal     @default(0) @db.Decimal(18, 4)
  marginTotal   Decimal     @default(0) @map("margin_total") @db.Decimal(18, 4)
  deliveryAddressId String? @map("delivery_address_id") @db.Uuid
  requestedDate DateTime?   @map("requested_date") @db.Date
  notes         String?
  sellerId      String?     @map("seller_id") @db.Uuid
  version       Int         @default(1)
  confirmedAt   DateTime?   @map("confirmed_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?     @map("created_by") @db.Uuid
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  customer      Customer             @relation(fields: [customerId], references: [id])
  quote         Quote?               @relation(fields: [quoteId], references: [id])
  warehouse     Warehouse            @relation(fields: [warehouseId], references: [id])
  lines         SalesOrderLine[]
  statusHistory OrderStatusHistory[]
  deliveries    Delivery[]

  @@unique([tenantId, number])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, status])
  @@map("sales_orders")
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  PICKING
  READY
  DISPATCHED
  DELIVERED
  INVOICED
  CANCELLED
}

model SalesOrderLine {
  id          String  @id @default(uuid()) @db.Uuid
  orderId     String  @map("order_id") @db.Uuid
  variantId   String  @map("variant_id") @db.Uuid
  quantity    Decimal @db.Decimal(18, 3)
  deliveredQty Decimal @default(0) @map("delivered_qty") @db.Decimal(18, 3)
  unitPrice   Decimal @map("unit_price") @db.Decimal(18, 4)
  discountPct Decimal @default(0) @map("discount_pct") @db.Decimal(5, 2)
  taxRateId   String? @map("tax_rate_id") @db.Uuid
  unitCost    Decimal @map("unit_cost") @db.Decimal(18, 4)
  lineTotal   Decimal @map("line_total") @db.Decimal(18, 4)

  order       SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  allocations OrderAllocation[]

  @@map("sales_order_lines")
}

// Stock reservado para cada línea al confirmar (por lote, FEFO). Al despachar se descuenta
// de esos mismos saldos; al cancelar se libera.
model OrderAllocation {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderLineId String   @map("order_line_id") @db.Uuid
  stockItemId String   @map("stock_item_id") @db.Uuid
  lotId       String?  @map("lot_id") @db.Uuid
  quantity    Decimal  @db.Decimal(18, 3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  line      SalesOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  stockItem StockItem      @relation(fields: [stockItemId], references: [id])
  lot       Lot?           @relation(fields: [lotId], references: [id])

  @@index([orderLineId])
  @@map("order_allocations")
}

model OrderStatusHistory {
  id        String      @id @default(uuid()) @db.Uuid
  orderId   String      @map("order_id") @db.Uuid
  from      OrderStatus?
  to        OrderStatus
  changedAt DateTime    @default(now()) @map("changed_at") @db.Timestamptz
  changedBy String?     @map("changed_by")
  reason    String?

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

// -----------------------------------------------------------------------------
// INVENTARIO (lotes + FEFO)
// -----------------------------------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")

  branch     Branch          @relation(fields: [branchId], references: [id])
  stockItems StockItem[]
  movements  StockMovement[]
  orders     SalesOrder[]

  @@unique([tenantId, code])
  @@map("warehouses")
}

model Lot {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  variantId    String    @map("variant_id") @db.Uuid
  code         String
  supplierLot  String?   @map("supplier_lot")
  supplierId   String?   @map("supplier_id") @db.Uuid
  producedAt   DateTime? @map("produced_at") @db.Date
  expiresAt    DateTime? @map("expires_at") @db.Date
  qualityStatus String   @default("APPROVED") @map("quality_status") // QUARANTINE, APPROVED, REJECTED
  analysisDocumentId String? @map("analysis_document_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  variant     ProductVariant    @relation(fields: [variantId], references: [id])
  stockItems  StockItem[]
  allocations OrderAllocation[]

  @@unique([tenantId, variantId, code])
  @@index([tenantId, expiresAt])
  @@map("lots")
}

// Saldo por variante × depósito × lote. Se actualiza solo vía StockMovement.
model StockItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  variantId   String   @map("variant_id") @db.Uuid
  lotId       String?  @map("lot_id") @db.Uuid
  onHand      Decimal  @default(0) @map("on_hand") @db.Decimal(18, 3)
  reserved    Decimal  @default(0) @db.Decimal(18, 3)
  version     Int      @default(1)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  lot         Lot?              @relation(fields: [lotId], references: [id])
  allocations OrderAllocation[]

  @@unique([warehouseId, variantId, lotId])
  @@index([tenantId, variantId])
  @@map("stock_items")
}

model StockMovement {
  id            String       @id @default(uuid()) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  warehouseId   String       @map("warehouse_id") @db.Uuid
  variantId     String       @map("variant_id") @db.Uuid
  lotId         String?      @map("lot_id") @db.Uuid
  type          MovementType
  quantity      Decimal      @db.Decimal(18, 3) // positivo entra, negativo sale
  unitCost      Decimal?     @map("unit_cost") @db.Decimal(18, 4)
  referenceType String?      @map("reference_type") // sales_order, purchase_order, adjustment
  referenceId   String?      @map("reference_id") @db.Uuid
  reason        String?
  occurredAt    DateTime     @default(now()) @map("occurred_at") @db.Timestamptz
  createdBy     String?      @map("created_by")

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, variantId, occurredAt])
  @@map("stock_movements")
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE_DISPATCH
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN_IN
  PRODUCTION_IN
  PRODUCTION_OUT
  WASTE
}

// -----------------------------------------------------------------------------
// COMPRAS
// -----------------------------------------------------------------------------

model Supplier {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String
  legalName    String    @map("legal_name")
  taxId        String?   @map("tax_id")
  country      String?   @db.Char(2)
  phone        String?
  email        String?   @db.Citext
  paymentTermsDays Int   @default(0) @map("payment_terms_days")
  leadTimeDays Int       @default(7) @map("lead_time_days")
  rating       Int? // 1-5, calidad/puntualidad
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

model SupplierProduct {
  supplierId   String   @map("supplier_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  supplierSku  String?  @map("supplier_sku")
  lastCost     Decimal? @map("last_cost") @db.Decimal(18, 4)
  currency     String   @default("ARS") @db.Char(3)
  minOrderQty  Decimal? @map("min_order_qty") @db.Decimal(18, 3)
  isPreferred  Boolean  @default(false) @map("is_preferred")

  supplier Supplier       @relation(fields: [supplierId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@id([supplierId, variantId])
  @@map("supplier_products")
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  branchId     String              @map("branch_id") @db.Uuid
  number       String
  supplierId   String              @map("supplier_id") @db.Uuid
  status       PurchaseOrderStatus @default(DRAFT)
  currency     String              @default("ARS") @db.Char(3)
  total        Decimal             @default(0) @db.Decimal(18, 4)
  expectedDate DateTime?           @map("expected_date") @db.Date
  suggestedByAgent Boolean         @default(false) @map("suggested_by_agent")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  createdBy    String?             @map("created_by") @db.Uuid

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, number])
  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderLine {
  id              String  @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  variantId       String  @map("variant_id") @db.Uuid
  quantity        Decimal @db.Decimal(18, 3)
  receivedQty     Decimal @default(0) @map("received_qty") @db.Decimal(18, 3)
  unitCost        Decimal @map("unit_cost") @db.Decimal(18, 4)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  warehouseId     String   @map("warehouse_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz
  lines           Json // [{variantId, qty, lotCode, expiresAt}]
  receivedBy      String?  @map("received_by") @db.Uuid

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  @@map("goods_receipts")
}

// -----------------------------------------------------------------------------
// LOGÍSTICA
// -----------------------------------------------------------------------------

model Carrier {
  id        String     @id @default(uuid()) @db.Uuid
  tenantId  String     @map("tenant_id") @db.Uuid
  name      String
  taxId     String?    @map("tax_id")
  phone     String?
  isOwnFleet Boolean   @default(false) @map("is_own_fleet")
  vehicles  Vehicle[]
  deliveries Delivery[]

  @@map("carriers")
}

model Vehicle {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  carrierId  String  @map("carrier_id") @db.Uuid
  plate      String
  capacityKg Decimal @map("capacity_kg") @db.Decimal(12, 2)

  carrier Carrier @relation(fields: [carrierId], references: [id])
  routes  Route[]

  @@unique([tenantId, plate])
  @@map("vehicles")
}

model Route {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  branchId   String      @map("branch_id") @db.Uuid
  date       DateTime    @db.Date
  vehicleId  String?     @map("vehicle_id") @db.Uuid
  driverName String?     @map("driver_name")
  status     String      @default("PLANNED") // PLANNED, IN_PROGRESS, DONE
  optimizedAt DateTime?  @map("optimized_at") @db.Timestamptz

  vehicle    Vehicle?    @relation(fields: [vehicleId], references: [id])
  stops      RouteStop[]

  @@map("routes")
}

model RouteStop {
  id         String  @id @default(uuid()) @db.Uuid
  routeId    String  @map("route_id") @db.Uuid
  deliveryId String  @unique @map("delivery_id") @db.Uuid
  position   Int
  eta        DateTime? @db.Timestamptz

  route    Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  delivery Delivery @relation(fields: [deliveryId], references: [id])

  @@map("route_stops")
}

model Delivery {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  orderId      String         @map("order_id") @db.Uuid
  carrierId    String?        @map("carrier_id") @db.Uuid
  status       DeliveryStatus @default(PENDING)
  trackingCode String?        @map("tracking_code")
  scheduledAt  DateTime?      @map("scheduled_at") @db.Timestamptz
  deliveredAt  DateTime?      @map("delivered_at") @db.Timestamptz
  proofUrl     String?        @map("proof_url") // remito firmado / foto
  notes        String?

  order   SalesOrder @relation(fields: [orderId], references: [id])
  carrier Carrier?   @relation(fields: [carrierId], references: [id])
  stop    RouteStop?

  @@index([tenantId, status])
  @@map("deliveries")
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

// -----------------------------------------------------------------------------
// COBRANZA (cuenta corriente)
// -----------------------------------------------------------------------------

model CustomerAccount {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @unique @map("customer_id") @db.Uuid
  currency    String   @default("ARS") @db.Char(3)
  balance     Decimal  @default(0) @db.Decimal(18, 4) // denormalizado de ledger_entries
  overdue     Decimal  @default(0) @db.Decimal(18, 4)
  oldestDueAt DateTime? @map("oldest_due_at") @db.Date
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  customer Customer      @relation(fields: [customerId], references: [id])
  entries  LedgerEntry[]
  invoices Invoice[]
  payments Payment[]
  riskAssessments RiskAssessment[]

  @@map("customer_accounts")
}

model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  date          DateTime @db.Date
  type          String // INVOICE, CREDIT_NOTE, DEBIT_NOTE, PAYMENT, ADJUSTMENT
  referenceId   String   @map("reference_id") @db.Uuid
  debit         Decimal  @default(0) @db.Decimal(18, 4)
  credit        Decimal  @default(0) @db.Decimal(18, 4)
  description   String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  account CustomerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, date])
  @@map("ledger_entries")
}

model Invoice {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  accountId   String        @map("account_id") @db.Uuid
  orderId     String?       @map("order_id") @db.Uuid
  type        String // A, B, NC-A...
  pointOfSale Int           @map("point_of_sale")
  number      Int
  issueDate   DateTime      @map("issue_date") @db.Date
  dueDate     DateTime      @map("due_date") @db.Date
  total       Decimal       @db.Decimal(18, 4)
  pending     Decimal       @db.Decimal(18, 4)
  status      InvoiceStatus @default(OPEN)
  cae         String? // código de autorización electrónica (ARCA)
  externalRef String?       @map("external_ref") // id en ERP/facturador externo

  account     CustomerAccount     @relation(fields: [accountId], references: [id])
  allocations PaymentAllocation[]

  @@unique([tenantId, type, pointOfSale, number])
  @@index([tenantId, status, dueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  date      DateTime @db.Date
  method    String // transferencia, cheque, efectivo, echeq
  amount    Decimal  @db.Decimal(18, 4)
  reference String?
  createdBy String?  @map("created_by") @db.Uuid

  account     CustomerAccount     @relation(fields: [accountId], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(18, 4)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@id([paymentId, invoiceId])
  @@map("payment_allocations")
}

model RiskAssessment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  accountId  String   @map("account_id") @db.Uuid
  score      Int // 0 (sin riesgo) - 100
  level      String // LOW, MEDIUM, HIGH, CRITICAL
  factors    Json // días de mora, tendencia de compra, cheques rechazados...
  explanation String? // generado por el agente de cobranza
  assessedAt DateTime @default(now()) @map("assessed_at") @db.Timestamptz

  account CustomerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, assessedAt])
  @@map("risk_assessments")
}

// -----------------------------------------------------------------------------
// DOCUMENTOS + GOOGLE DRIVE
// -----------------------------------------------------------------------------

model Document {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String
  kind        DocumentKind
  entityType  String?      @map("entity_type") // product, customer, supplier, lot
  entityId    String?      @map("entity_id") @db.Uuid
  tags        String[]     @default([])
  validUntil  DateTime?    @map("valid_until") @db.Date // certificados con vencimiento
  visibility  String       @default("INTERNAL") // INTERNAL, ROLE_RESTRICTED, PUBLIC
  allowedRoles String[]    @default([]) @map("allowed_roles")
  currentVersionId String? @map("current_version_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz

  versions  DocumentVersion[]
  driveFile DriveFile?

  @@index([tenantId, kind])
  @@index([tenantId, entityType, entityId])
  @@map("documents")
}

enum DocumentKind {
  TECHNICAL_SHEET
  CERTIFICATE
  LAB_ANALYSIS
  CATALOG
  PRICE_LIST
  MANUAL
  CONTRACT
  QUOTE_PDF
  OTHER
}

model DocumentVersion {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  documentId    String   @map("document_id") @db.Uuid
  versionNo     Int      @map("version_no")
  storageKey    String?  @map("storage_key") // MinIO
  driveRevisionId String? @map("drive_revision_id")
  mimeType      String   @map("mime_type")
  checksum      String
  extractedText String?  @map("extracted_text")
  indexedAt     DateTime? @map("indexed_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  createdBy     String?  @map("created_by")

  document Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   KnowledgeChunk[]

  @@unique([documentId, versionNo])
  @@map("document_versions")
}

model DriveConnection {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  googleAccount   String    @map("google_account")
  encryptedTokens Bytes     @map("encrypted_tokens") // AES-256-GCM, nunca en claro
  rootFolderIds   String[]  @map("root_folder_ids")
  changesPageToken String?  @map("changes_page_token")
  watchChannelId  String?   @map("watch_channel_id")
  watchExpiresAt  DateTime? @map("watch_expires_at") @db.Timestamptz
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz
  status          String    @default("ACTIVE")

  files DriveFile[]

  @@unique([tenantId, googleAccount])
  @@map("drive_connections")
}

model DriveFile {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  connectionId  String    @map("connection_id") @db.Uuid
  driveFileId   String    @map("drive_file_id")
  documentId    String?   @unique @map("document_id") @db.Uuid
  name          String
  mimeType      String    @map("mime_type")
  parents       String[]
  webViewLink   String?   @map("web_view_link")
  md5           String?
  modifiedTime  DateTime  @map("modified_time") @db.Timestamptz
  syncStatus    String    @default("PENDING") @map("sync_status") // PENDING, INDEXED, SKIPPED, ERROR
  lastError     String?   @map("last_error")

  connection DriveConnection @relation(fields: [connectionId], references: [id])
  document   Document?       @relation(fields: [documentId], references: [id])

  @@unique([connectionId, driveFileId])
  @@map("drive_files")
}

// -----------------------------------------------------------------------------
// WHATSAPP
// -----------------------------------------------------------------------------

model WhatsappAccount {
  id                 String  @id @default(uuid()) @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  phoneNumberId      String  @unique @map("phone_number_id") // id de Meta
  displayPhone       String  @map("display_phone")
  wabaId             String  @map("waba_id")
  encryptedToken     Bytes   @map("encrypted_token")
  branchId           String? @map("branch_id") @db.Uuid
  autoCreateCustomer Boolean @default(true) @map("auto_create_customer")

  conversations Conversation[]

  @@map("whatsapp_accounts")
}

model Conversation {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  accountId    String    @map("account_id") @db.Uuid
  waContactId  String    @map("wa_contact_id") // teléfono E.164
  contactName  String?   @map("contact_name")
  customerId   String?   @map("customer_id") @db.Uuid
  leadId       String?   @map("lead_id") @db.Uuid
  assignedTo   String?   @map("assigned_to") @db.Uuid
  status       String    @default("OPEN") // OPEN, PENDING, CLOSED
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz
  windowExpiresAt DateTime? @map("window_expires_at") @db.Timestamptz // ventana de 24 h de Meta
  summary      String?
  sentiment    String?

  account  WhatsappAccount @relation(fields: [accountId], references: [id])
  customer Customer?       @relation(fields: [customerId], references: [id])
  messages Message[]

  @@unique([accountId, waContactId])
  @@index([tenantId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  tenantId       String           @map("tenant_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  waMessageId    String           @unique @map("wa_message_id")
  direction      MessageDirection
  type           String // text, audio, image, document, template, interactive
  body           String?
  mediaKey       String?          @map("media_key") // MinIO
  transcript     String? // audios transcritos
  intent         String? // purchase_intent, complaint, price_request, payment_promise
  intentScore    Float?           @map("intent_score")
  status         String           @default("RECEIVED") // SENT, DELIVERED, READ, FAILED
  sentBy         String?          @map("sent_by") // user id o agent:*
  sentAt         DateTime         @map("sent_at") @db.Timestamptz

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, sentAt])
  @@index([tenantId, intent])
  @@map("messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

// -----------------------------------------------------------------------------
// CONOCIMIENTO (RAG) Y COPILOTO
// -----------------------------------------------------------------------------

model KnowledgeSource {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  type       String // drive, document, whatsapp, crm, product, order, manual
  refId      String   @map("ref_id") // id de la entidad origen
  title      String
  acl        Json     @default("{\"roles\":[]}") // roles que pueden recuperarlo
  hash       String // detecta cambios para reindexar
  indexedAt  DateTime? @map("indexed_at") @db.Timestamptz
  status     String   @default("PENDING")

  chunks KnowledgeChunk[]

  @@unique([tenantId, type, refId])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id          String   @id @default(uuid()) @db.Uuid // = point id en Qdrant
  tenantId    String   @map("tenant_id") @db.Uuid
  sourceId    String   @map("source_id") @db.Uuid
  versionId   String?  @map("version_id") @db.Uuid
  ordinal     Int
  content     String
  tokenCount  Int      @map("token_count")
  metadata    Json     @default("{}") // página, sección, producto, cliente
  embeddingModel String @map("embedding_model")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  source  KnowledgeSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  version DocumentVersion? @relation(fields: [versionId], references: [id])

  @@index([sourceId, ordinal])
  @@map("knowledge_chunks")
}

model CopilotSession {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?
  context   Json     @default("{}") // pantalla y entidad desde donde se abrió
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  messages CopilotMessage[]
  runs     AgentRun[]

  @@index([tenantId, userId, createdAt])
  @@map("copilot_sessions")
}

model CopilotMessage {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  role      String // user, assistant, tool
  content   Json
  citations Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  session CopilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("copilot_messages")
}

model AgentRun {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  agent       String // commercial, pricing, purchasing, inventory, collections, executive, documents
  sessionId   String?   @map("session_id") @db.Uuid
  trigger     String // user, schedule, event, rule
  onBehalfOf  String?   @map("on_behalf_of") @db.Uuid
  status      String    @default("RUNNING") // RUNNING, SUCCEEDED, FAILED, AWAITING_APPROVAL
  model       String
  inputTokens Int       @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd     Decimal   @default(0) @map("cost_usd") @db.Decimal(10, 6)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz
  error       String?

  session   CopilotSession? @relation(fields: [sessionId], references: [id])
  toolCalls ToolCall[]

  @@index([tenantId, agent, startedAt])
  @@map("agent_runs")
}

model ToolCall {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @map("run_id") @db.Uuid
  tool       String // crm.findCustomersAtRisk, sales.createQuote
  input      Json
  output     Json?
  isWrite    Boolean  @default(false) @map("is_write")
  approvedBy String?  @map("approved_by") @db.Uuid // escrituras sensibles requieren aprobación humana
  durationMs Int?     @map("duration_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@map("tool_calls")
}

// -----------------------------------------------------------------------------
// AUTOMATIZACIÓN, TAREAS, NOTIFICACIONES
// -----------------------------------------------------------------------------

// SI <trigger> Y <conditions> ENTONCES <actions>
model AutomationRule {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  triggerType String   @map("trigger_type") // EVENT, SCHEDULE
  eventType   String?  @map("event_type") // message.received, quote.created
  schedule    String? // cron: "0 8 * * 1-5"
  conditions  Json // árbol {all:[{field,op,value}], any:[...]}
  actions     Json // [{type:"create_task", params:{...}}, {type:"notify", ...}]
  isActive    Boolean  @default(true) @map("is_active")
  createdBy   String?  @map("created_by")  // usuario o "agent:executive"
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  executions RuleExecution[]

  @@index([tenantId, eventType, isActive])
  @@map("automation_rules")
}

model RuleExecution {
  id         String   @id @default(uuid()) @db.Uuid
  ruleId     String   @map("rule_id") @db.Uuid
  eventId    String?  @map("event_id") // idempotencia
  matched    Boolean
  result     Json?
  error      String?
  executedAt DateTime @default(now()) @map("executed_at") @db.Timestamptz

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, eventId])
  @@map("rule_executions")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String
  description String?
  assigneeId  String?      @map("assignee_id") @db.Uuid
  entityType  String?      @map("entity_type")
  entityId    String?      @map("entity_id") @db.Uuid
  dueAt       DateTime?    @map("due_at") @db.Timestamptz
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(OPEN)
  origin      String       @default("manual") // manual, rule:<id>, agent:<name>, whatsapp
  completedAt DateTime?    @map("completed_at") @db.Timestamptz
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  createdBy   String?      @map("created_by")

  @@index([tenantId, assigneeId, status])
  @@map("tasks")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  channel   String    @default("IN_APP") // IN_APP, EMAIL, WHATSAPP, PUSH
  title     String
  body      String
  link      String?
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, readAt])
  @@map("notifications")
}
